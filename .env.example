# Copy to .env for local development. Placeholder values only; never commit .env.

# Postgres container
POSTGRES_USER=cuesense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cuesense

# API (hostname "postgres" is the Docker Compose service name)
DATABASE_URL=postgresql+psycopg://cuesense:change-me@postgres:5432/cuesense
TEST_DATABASE_URL=postgresql+psycopg://cuesense:change-me@postgres:5432/cuesense_test
# Hours without an attempt before an open practice session is closed on its next load
SESSION_IDLE_HOURS=6

# Web (server-side calls to the API inside Docker Compose)
API_URL=http://api:8000

# Sign-in: how long a sign-in lasts (hours), and whether the cookie is Secure (true behind https)
SESSION_TTL_HOURS=720
SESSION_COOKIE_SECURE=false
# Password the seed gives the local dev user (dev@cuesense.local). Local development and tests only
DEV_USER_PASSWORD=change-me-dev-password
