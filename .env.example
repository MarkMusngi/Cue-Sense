# Copy to .env for local development. Placeholder values only; never commit .env.

# Postgres container
POSTGRES_USER=cuesense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cuesense

# API (hostname "postgres" is the Docker Compose service name)
DATABASE_URL=postgresql+psycopg://cuesense:change-me@postgres:5432/cuesense
TEST_DATABASE_URL=postgresql+psycopg://cuesense:change-me@postgres:5432/cuesense_test

# Web (server-side calls to the API inside Docker Compose)
API_URL=http://api:8000
